# Copia este archivo a ".env" y completa los valores.
# El PAT es un secreto: nunca lo dejes en el repositorio ni en el frontend.

# Organización de Azure DevOps (solo lectura del backlog)
# Reemplazar por la organización de tu proyecto.
AZURE_ORG_URL=

# Proyecto. Se tolera pegar la URL completa del proyecto.
AZURE_PROYECTO=

# Personal Access Token con alcance "WorkItems: Read".
# https://dev.azure.com/<org>/_usersSettings/tokens
AZURE_PAT=

# AreaPath para filtrar las épicas (vacío => se usa el proyecto).
AREA_PATH=

# Servidor
HOST=127.0.0.1
PUERTO=8000
# Solo usar true detrás de un proxy TLS/autenticado; el proceso rechaza
# cualquier binding externo sin esta opción explícita.
PERMITIR_EXTERNO=false
LOG_NIVEL=INFO
ORIGEN_CORS=http://localhost:5173

# Comportamiento
CACHE_TTL_SEG=120
TIMEOUT_SEG=30