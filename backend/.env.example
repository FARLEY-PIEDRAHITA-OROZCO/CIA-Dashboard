# Copia este archivo a ".env" y completa los valores.
# El PAT es un secreto: nunca lo dejes en el repositorio ni en el frontend.

# Organización de Azure DevOps (solo lectura del backlog)
# Reemplazar por la organización de tu proyecto.
AZURE_ORG_URL=

# Proyecto. Se tolera pegar la URL completa del proyecto.
AZURE_PROYECTO=

# Personal Access Token con alcance "WorkItems: Read".
# https://dev.azure.com/<org>/_usersSettings/tokens
AZURE_PAT=

# AreaPath para filtrar las épicas (vacío => se usa el proyecto).
AREA_PATH=

# --- Escritura QA (opcional, ADR-11) --------------------------------- #
# El sistema es de SOLO LECTURA por defecto. Para permitir edición de
# tags/estado/prioridad/severidad y notas QA:
#
#   1. Crea un PAT **dedicado** con alcance "WorkItems: Read & Write".
#      Azure envía un correo de notificación al crearlo.
#   2. Pégalo abajo y activa el flag.
#
# El PAT de escritura es independiente del de lectura para poder revocar la
# escritura sin perder la consulta del backlog. NUNCA se expone al navegador.
#
# IMPORTANTE: la escritura solo es válida con HOST en loopback. El proceso
# rechaza la configuración si se habilita con un binding externo, porque esta
# app no tiene autenticación propia.
AZURE_PAT_ESCRITURA=
ESCRITURA_HABILITADA=false

# Servidor
HOST=127.0.0.1
PUERTO=8000
# Solo usar true detrás de un proxy TLS/autenticado; el proceso rechaza
# cualquier binding externo sin esta opción explícita.
PERMITIR_EXTERNO=false
LOG_NIVEL=INFO
ORIGEN_CORS=http://localhost:5173

# Comportamiento
CACHE_TTL_SEG=120
TIMEOUT_SEG=30

# --- Monitor de llamadas a Azure (opcional) ----------------------------- #
# Cuenta las peticiones que el backend hace a Azure: cuántas, de qué tipo,
# cuánto tardan, cuántas fallan y cuántas van simultáneas.
#
# Apagado por defecto a propósito. No es un adorno: es la única forma de
# medir el coste real de una vista, y para eso hay que poder encenderla,
# mirar y apagarla. Un monitor que no se puede apagar acaba siempre encendido,
# y un monitor siempre encendido es ruido que se ignora.
#
# Con MONITOR_HABILITADA=false el endpoint /api/monitor/azure devuelve 404,
# que es la forma honesta de decir «esto no está midiendo nada».
MONITOR_HABILITADA=false

# --- Registro local de pruebas (opcional) ------------------------------ #
# Copia de seguridad de `backend/datos/asignaciones.json`, que es el ÚNICO sitio
# donde existe la información de qué épica lleva cada persona. Azure no tiene
# ningún campo para ella: el tipo Epic de este proyecto no tiene System.Tags,
# System.HyperLink ni ningún Custom.* propio (medido), y añadir uno sería
# plantilla de proceso, con permisos de administrador y afecta a todo el proyecto.
#
# El registro NO está en git. Es un dato, no código: exigir un commit por cada
# asignación convertía el respaldo en un ritual.
#
# Ruta ABSOLUTA, y **entre comillas SIMPLES**.
#
# Con comillas DOBLES, python-dotenv interpreta escapes de Python: `\f` se
# convierte en un salto de formulario y `\a` en un pitido. Una ruta como
# C:\Users\frlpi\...\asignaciones.json llega con dos caracteres de control en
# medio y no puede existir nunca — y el aviso sería «la carpeta no existe», sin
# más explicación. Palabras corriente que disparan esto: formularios, artefactos,
# tablas, riesgos, nuevo, base, varios.
#
# Vacía = sin copia, y la interfaz lo avisa, porque un registro sin respaldo es un
# riesgo que tiene que verse y no una ausencia silenciosa.
#
# OJO: apuntar a una carpeta de OneDrive en un equipo donde el cliente está
# instalado pero SIN sesión iniciada produce un fichero que parece respaldado y
# no lo está. Comprueba que la carpeta existe antes de confiar en ella —la
# aplicación también lo comprueba y avisa—, porque esa es la forma más cómoda de
# perder datos sin enterarse.
#
# REGISTRO_COPIA_RUTA='C:\Users\tu.usuario\OneDrive - Tu Empresa\1. Iniciativas\asignaciones.json'
REGISTRO_COPIA_RUTA=