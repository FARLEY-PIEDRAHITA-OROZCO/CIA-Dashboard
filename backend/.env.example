# Copia este archivo a ".env" y completa los valores.
# El PAT es un secreto: nunca lo dejes en el repositorio ni en el frontend.

# Organización de Azure DevOps (solo lectura del backlog)
# Reemplazar por la organización de tu proyecto.
AZURE_ORG_URL=

# Proyecto. Se tolera pegar la URL completa del proyecto.
AZURE_PROYECTO=

# Personal Access Token con alcance "WorkItems: Read".
# https://dev.azure.com/<org>/_usersSettings/tokens
AZURE_PAT=

# AreaPath para filtrar las épicas (vacío => se usa el proyecto).
AREA_PATH=

# --- Escritura QA (opcional, ADR-11) --------------------------------- #
# El sistema es de SOLO LECTURA por defecto. Para permitir edición de
# tags/estado/prioridad/severidad y notas QA:
#
#   1. Crea un PAT **dedicado** con alcance "WorkItems: Read & Write".
#      Azure envía un correo de notificación al crearlo.
#   2. Pégalo abajo y activa el flag.
#
# El PAT de escritura es independiente del de lectura para poder revocar la
# escritura sin perder la consulta del backlog. NUNCA se expone al navegador.
#
# IMPORTANTE: la escritura solo es válida con HOST en loopback. El proceso
# rechaza la configuración si se habilita con un binding externo, porque esta
# app no tiene autenticación propia.
AZURE_PAT_ESCRITURA=
ESCRITURA_HABILITADA=false

# Servidor
HOST=127.0.0.1
PUERTO=8000
# Solo usar true detrás de un proxy TLS/autenticado; el proceso rechaza
# cualquier binding externo sin esta opción explícita.
PERMITIR_EXTERNO=false
LOG_NIVEL=INFO
ORIGEN_CORS=http://localhost:5173

# Comportamiento
CACHE_TTL_SEG=120
TIMEOUT_SEG=30